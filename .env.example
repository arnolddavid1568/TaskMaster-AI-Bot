# Copy this file to .env for local development (or set these as
# environment variables in Render/Railway's dashboard for deployment).

# Required: get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Comma-separated Telegram user IDs allowed to use /stats, /logs, /ban, etc.
# Send /id to the bot (as yourself) to find your Telegram user ID.
ADMIN_IDS=123456789

# Optional: enables AI-powered /summarize and /rewrite via Claude.
# Leave blank to use the built-in local algorithm instead (no key needed).
ANTHROPIC_API_KEY=

# Optional tuning (sensible defaults are used if omitted)
MAX_FILE_SIZE_MB=20
FILE_RETENTION_MINUTES=30
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=60
MAX_CONCURRENT_TASKS=3
MAX_QUEUE_SIZE=50
